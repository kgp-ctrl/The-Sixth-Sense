  "authors": [
    "Gareyn_"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/the-sixth-sense",
    "sources": "https://github.com/kgp-ctrl/The-Sixth-Sense",
    "issues": "https://github.com/kgp-ctrl/The-Sixth-Sense/issues"
  },
  "license": "All Rights Reserved",
  "icon": "assets/sixthsense/icon.png",
  "environment": "*",
  "accessWidener": "sixthsense.accesswidener",
  "entrypoints": {
    "client": [
      "com.surins.SixthSenseClient"
    ],
    "modmenu": [
      "com.surins.SixthSenseModMenuIntegration"
    ],
    "main": [
      "com.surins.SixthSenseCommon"
    ]
  },
  "mixins": [
    "SixthSense.mixin.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
